{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // The court snapshot is generated data and larger than Biome's file limit.
    "includes": ["**", "!data/courts.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        // Button groups and carousel slides use role="group" on purpose. Biome asks for fieldset.
        "useSemanticElements": "off",
        // Backdrop clicks and stopPropagation are not controls. Keyboard close is a button or Escape.
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      },
      "performance": {
        // Photos, the coffee badge, and the Open Graph image are not next/image candidates.
        "noImgElement": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
