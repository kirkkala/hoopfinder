# LIPAS is a public API and does not require a key.
# Override only if you point at a proxy or another environment.
LIPAS_API_BASE=https://api.lipas.fi/v2

# Optional Overpass URL for OSM courts. Leave unset unless you have your own
# Overpass server — the refresh script already retries when the public one times out.
# OVERPASS_API_BASE=https://overpass-api.de/api/interpreter

# Postgres for visitor-submitted courts. Local: docker compose up -d
DATABASE_URL=postgres://hoopfinder:hoopfinder@localhost:5432/hoopfinder

# Google sign-in for /admin.
# Generate AUTH_SECRET with: npx auth secret
# https://console.cloud.google.com/auth/clients?project=hoopfinder-509413
# On Vercel production, also set NEXTAUTH_URL=https://www.hoopfinder.fi
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts that can access /admin with google login.
ADMIN_EMAILS=timo.kirkkala@gmail.com
