{
  "name": "hoopfinder",
  "version": "0.1.0-beta.18",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "refresh-courts": "tsx scripts/refresh-courts.ts",
    "refresh-courts:lipas": "tsx scripts/refresh-courts.ts --lipas-only",
    "refresh-courts:osm-places": "tsx scripts/refresh-courts.ts --osm-places",
    "postinstall": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/"
  },
  "dependencies": {
    "@lucide/lab": "^0.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
